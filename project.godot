config_version=5

[application]

config/name="Mines Schooler"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.2")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"

environment/defaults/default_clear_color=Color(0.08,0.09,0.12,1)

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

global_illumination/gi/use_half_resolution=false

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":87)]
}

move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":83)]
}

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":65)]
}

move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":68)]
}
